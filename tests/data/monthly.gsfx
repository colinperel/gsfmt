=IFNA(
  LET(
    lastRow,     stock_data!A1,
    binCount,    12,
    datesCapped, C4:INDEX(C:C, LOOKUP(2, 1 / (C4:C <> ""), ROW(C4:C))),

    weights,     stock_data!F2:INDEX(stock_data!F:F, lastRow),
    tags,        stock_data!H2:INDEX(stock_data!H:H, lastRow),
    isLive,      ARRAYFORMULA((weights > 0) * ISERROR(SEARCH("archived", tags))),

    shipments,   FILTER(
                   HSTACK(
                     stock_data!B2:INDEX(stock_data!C:C, lastRow),
                     stock_data!J2:INDEX(stock_data!U:U, lastRow)
                   ),
                   isLive
                 ),

    arrivals,    CHOOSECOLS(shipments, 1),
    departures,  CHOOSECOLS(shipments, 2),

    binData,     CHOOSECOLS(shipments, SEQUENCE(binCount * 2, 1, 3)),
    binSlice,    LAMBDA(startCol,
                   CHOOSECOLS(
                     binData,
                     SEQUENCE(binCount, 1, startCol)
                   )
                 ),

    onesCol,     SEQUENCE(binCount, 1, 1, 0),
    binTotals,   BYCOL(binSlice(1), LAMBDA(col, SUM(col))),

    overlap,     ARRAYFORMULA(
                   (arrivals < EDATE(datesCapped, 1))
                     * (departures >= datesCapped)
                 ),
    perBin,      MMULT(TRANSPOSE(overlap * 1), onesCol),

    LAMBDA(x, ROUND(SUM(x), 2))(binTotals)
      + SUMPRODUCT(Inventory[Weight kg], perBin)
  ),
  "no data"
)
